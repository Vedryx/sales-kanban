# === Mongo (reuse vedryx cluster) ===
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=vedryx

# === Preview/Prod toggle (Vercel sets this on preview target only) ===
PREVIEW_MODE=false

# === NextAuth v5 ===
# In prod NEXTAUTH_URL is auto-derived on Vercel; trustHost handles previews.
AUTH_SECRET=__openssl_rand_base64_32__
AUTH_URL=http://localhost:3000

# === Google OAuth (Cloud Console → Credentials) ===
# Authorised redirect: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Access control ===
# CSV of email domains permitted to sign in. Defaults to vedryxtech.com.
ALLOWED_EMAIL_DOMAINS=vedryxtech.com,apxlabs.ai

# === Misc ===
LOG_LEVEL=info
TZ=Asia/Kolkata
