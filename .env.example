# === Mongo (reuse vedryx cluster) ===
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=vedryx

# === Preview/Prod toggle (Vercel sets this on preview target only) ===
PREVIEW_MODE=false

# === NextAuth v5 ===
# In prod NEXTAUTH_URL is auto-derived on Vercel; trustHost handles previews.
AUTH_SECRET=__openssl_rand_base64_32__
AUTH_URL=http://localhost:3000

# === Google OAuth (Cloud Console → Credentials) ===
# Authorised redirect: <AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Access control ===
# Per-email allowlist lives in /allowlist.json (committed in repo).
# Add/remove an email there + redeploy to grant/revoke access.

# === Outbound email (Resend) ===
# Create at https://resend.com/api-keys.
# Sending domain MUST be verified in Resend (DKIM + SPF in Namecheap DNS).
# Free tier: 100 emails/day, 1 verified domain. Pro: $20/mo for 50k/mo.
RESEND_API_KEY=
# Must match a verified sender on the Resend domain.
PITCH_EMAIL_FROM=Vedryx Pulse <hello@pulse.vedryxtech.com>
# Kill-switch — feature OFF by default. Flip to 'true' (literal string) in
# Vercel env only after:
#  1. RESEND_API_KEY provisioned
#  2. Sending domain DKIM/SPF verified in Resend
#  3. TODO_POSTAL_ADDRESS in src/lib/email/template.ts replaced with the
#     registered business address (CAN-SPAM §7704 compliance gate).
PITCH_EMAIL_ENABLED=false
# Reply-To address on outbound pitch emails. Replies land in this shared
# inbox; a forward rule there forwards a copy to Resend inbound receiving,
# which fires /api/inbound/reply. Must be a real mailbox the team monitors.
REPLY_TO_EMAIL=sales@vedryxtech.com

# === Inbound email capture (Resend receiving + webhook) ===
# Webhook signing secret from Resend → Webhooks. Required when the inbound
# route is in use; route returns 401 on unverified signatures.
RESEND_WEBHOOK_SECRET=

# === Vercel Blob (screenshot uploads from pitch email modal) ===
# Auto-injected on Vercel. For local dev: `vercel link` then `vercel env pull .env.local`.
BLOB_READ_WRITE_TOKEN=

# === Misc ===
LOG_LEVEL=info
TZ=Asia/Kolkata
